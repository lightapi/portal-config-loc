version: 1
runnerId: personal-codex-runner
enrollmentId: personal-codex-runner-enrollment
hostId: 01964b05-552a-7c4b-9184-6857e7f3dc5f
controllerUrl: wss://localhost:8438/ws/runner
jwtFile: /absolute/path/to/personal-codex-runner.jwt
dataDirectory: /absolute/path/to/personal-codex-runner-data
healthAddress: 127.0.0.1:9444
maximumConcurrency: 1
heartbeatIntervalMs: 5000
reconnectMaximumMs: 30000
shutdownGraceMs: 29000
stagingMaximumBytes: 1073741824
orphanReconcileIntervalMs: 60000
orphanReconcileStartupTimeoutMs: 30000
backend:
  compatibilityDigest: sha256:replace-with-approved-local-backend-digest
  availableSlots: 1
  behavior:
    durationMs: 10
    stdout: "local personal runner\n"
    stderr: ""
    exitCode: 0
    outcome: success
    loseFirstResponse: false
    cleanupFails: false
allowedCommandTemplateDigests:
  - sha256:replace-with-codex-command-template-digest
agentWorker:
  originServiceId: com.networknt.agent.account-1.0.0
  executable: /absolute/path/to/light-agent-worker
  binaryDigest: sha256:replace-with-exact-worker-binary-digest
  capabilityDigest: sha256:replace-with-worker-capability-digest
  codexHome: /absolute/path/to/owner-only/codex-home
  codexExecutable: /absolute/path/to/native/codex
